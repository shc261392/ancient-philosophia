---
export interface Props {
  body?: string;
  wordCount?: number;
  lastReviewed?: string;
  reviewers?: string[];
}

const { body, wordCount, lastReviewed, reviewers = [] } = Astro.props;
const words = wordCount ?? (body ? body.trim().split(/\s+/).length : 0);
const minutes = Math.max(1, Math.round(words / 220));
const reviewed = lastReviewed
  ? new Date(lastReviewed).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })
  : null;
---

<div class="flex flex-wrap gap-x-4 gap-y-1 text-xs text-[var(--color-fg-muted)]">
  {words > 0 && (
    <span class="inline-flex items-center gap-1">
      <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
      {minutes} min read · {words.toLocaleString()} words
    </span>
  )}
  {reviewed && (
    <span class="inline-flex items-center gap-1" title={reviewers.length ? `Reviewed by ${reviewers.join(', ')}` : undefined}>
      <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M9 12l2 2 4-4"/><circle cx="12" cy="12" r="10"/></svg>
      Last reviewed {reviewed}
    </span>
  )}
</div>
