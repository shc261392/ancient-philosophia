---
import SEOHead from '../components/SEOHead.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import ImageLightbox from '../components/ImageLightbox.astro';
import ScrollProgress from '../components/ScrollProgress.astro';
import '../styles/global.css';

export interface BreadcrumbItem {
  label: string;
  href?: string;
}

export interface Props {
  title: string;
  description: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
  author?: string;
  section?: string;
  breadcrumbs?: BreadcrumbItem[];
}

const { title, description, image, type, publishedTime, modifiedTime, author, section, breadcrumbs } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <SEOHead
      title={title}
      description={description}
      image={image}
      type={type}
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
      author={author}
      section={section}
      breadcrumbs={breadcrumbs}
    />
  </head>
  <body class="min-h-screen flex flex-col">
    <ScrollProgress />
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-[100] focus:bg-[var(--color-gold-leaf)] focus:text-[var(--color-bg-primary)] focus:px-3 focus:py-1.5 focus:rounded">Skip to main content</a>
    <Nav />
    <main id="main" class="flex-1 w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <slot />
    </main>
    <Footer />
    <ImageLightbox />
  </body>
</html>
