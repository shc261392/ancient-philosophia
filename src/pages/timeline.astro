---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { getCollection } from 'astro:content';

const civs = await getCollection('civilizations');

function parseRange(s: string): { start: number; end: number } | null {
  // Examples: "c. 4500–1900 BCE", "c. 480–323 BCE", "27 BCE–476 CE"
  const cleaned = s.replace(/c\.?\s*/gi, '').trim();
  const m = cleaned.match(/(\d+)\s*(BCE|CE)?\s*[–-]\s*(\d+)\s*(BCE|CE)?/i);
  if (!m) return null;
  const era1 = (m[2] || m[4] || 'BCE').toUpperCase();
  const era2 = (m[4] || era1).toUpperCase();
  const n1 = parseInt(m[1], 10);
  const n2 = parseInt(m[3], 10);
  const start = era1 === 'BCE' ? -n1 : n1;
  const end = era2 === 'BCE' ? -n2 : n2;
  return { start: Math.min(start, end), end: Math.max(start, end) };
}

const items = civs
  .map(c => ({ ...c, range: parseRange(c.data.dateRange) }))
  .filter(c => c.range)
  .sort((a, b) => a.range!.start - b.range!.start);

const minYear = Math.min(...items.map(i => i.range!.start));
const maxYear = Math.max(...items.map(i => i.range!.end));
const total = maxYear - minYear;

function pct(n: number) { return ((n - minYear) / total) * 100; }

const regions = [...new Set(items.map(i => i.data.region))];
const palette = ['#c1604e', '#c9a84c', '#2a6478', '#6d7c3e', '#8B3A2A', '#4aadca', '#d9806e', '#8fa052'];
const regionColor: Record<string, string> = {};
regions.forEach((r, i) => { regionColor[r] = palette[i % palette.length]; });

function fmtYear(y: number) {
  return y < 0 ? `${-y} BCE` : `${y} CE`;
}

// Era ticks
const ticks: number[] = [];
const step = Math.ceil(total / 12 / 500) * 500;
for (let y = Math.ceil(minYear / step) * step; y <= maxYear; y += step) ticks.push(y);

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Timeline' },
];
---

<BaseLayout
  title="Timeline of Ancient Civilizations"
  description="A horizontal visual timeline of the ancient civilizations covered on this site, from Sumer to the fall of Rome."
  breadcrumbs={breadcrumbs}
>
  <Breadcrumbs trail={breadcrumbs} />

  <header class="mb-8">
    <h1 class="text-4xl sm:text-5xl font-serif font-bold text-[var(--color-gold-leaf)] mb-3">Timeline</h1>
    <p class="text-[var(--color-fg-secondary)] max-w-3xl">
      Every civilization on this site arranged along a single chronological axis. Bars are coloured
      by region. Hover (or tap) for details; click to read.
    </p>
  </header>

  <div class="legend flex flex-wrap gap-3 mb-6">
    {regions.map(r => (
      <span class="inline-flex items-center gap-1.5 text-xs text-[var(--color-fg-secondary)]">
        <span class="inline-block w-3 h-3 rounded-sm" style={`background:${regionColor[r]}`}></span>{r}
      </span>
    ))}
  </div>

  <div class="timeline relative overflow-x-auto rounded-xl border border-[var(--color-bg-tertiary)] bg-[var(--color-bg-card)] p-4">
    <div class="relative" style={`min-width: 900px; height: ${items.length * 28 + 60}px`}>
      <!-- Era ticks -->
      <div class="absolute inset-x-0 top-0 bottom-6 pointer-events-none">
        {ticks.map(y => (
          <div class="absolute top-0 bottom-0 border-l border-[var(--color-bg-tertiary)]/60" style={`left: ${pct(y)}%`}>
            <span class="absolute -top-1 -translate-x-1/2 text-[10px] text-[var(--color-fg-muted)] whitespace-nowrap">{fmtYear(y)}</span>
          </div>
        ))}
      </div>

      <!-- Bars -->
      <div class="absolute inset-x-0 top-6">
        {items.map((it, i) => {
          const left = pct(it.range!.start);
          const width = Math.max(0.4, pct(it.range!.end) - pct(it.range!.start));
          return (
            <a
              href={`/civilizations/${it.id}/`}
              class="absolute h-6 rounded text-[10px] text-white px-2 flex items-center whitespace-nowrap overflow-hidden hover:ring-2 hover:ring-[var(--color-gold-leaf)] transition-all"
              style={`top: ${i * 28}px; left: ${left}%; width: ${width}%; background-color: ${regionColor[it.data.region]}; min-width: 12px;`}
              title={`${it.data.title} · ${it.data.dateRange} · ${it.data.region}`}
            >
              <span class="truncate">{it.data.title}</span>
            </a>
          );
        })}
      </div>
    </div>
  </div>

  <p class="text-xs text-[var(--color-fg-muted)] mt-3">
    Date ranges are parsed from each article's <code>dateRange</code> field. Some boundaries are
    conventional and contested — see individual articles for nuance.
  </p>
</BaseLayout>
